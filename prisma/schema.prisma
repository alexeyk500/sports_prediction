generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TournamentStatus {
  SCHEDULED
  ACTIVE
  FINALIZING
  FINISHED
}

enum FixtureStatus {
  DRAFT
  OPEN
  LOCKED
  LIVE
  FINISHED
  SETTLED
}

enum PredictionOutcome {
  HOME
  DRAW
  AWAY
}

enum PredictionResultStatus {
  PENDING
  CORRECT
  INCORRECT
}

enum PredictionSlotType {
  FREE
  REWARDED
}

enum AdRewardStatus {
  CREATED
  VERIFIED
  CONSUMED
  EXPIRED
  REJECTED
}

enum PrizeClaimStatus {
  UNDER_REVIEW
  ACTION_REQUIRED
  PAID
  REJECTED
}

enum PrizeCurrency {
  USDT
  TON
}

enum RatingLeague {
  UNRANKED

  BRONZE_III
  BRONZE_II
  BRONZE_I

  SILVER_III
  SILVER_II
  SILVER_I

  GOLD_III
  GOLD_II
  GOLD_I

  PLATINUM_III
  PLATINUM_II
  PLATINUM_I

  DIAMOND_III
  DIAMOND_II
  DIAMOND_I

  MASTER
  LEGEND
}

enum UserLocale {
  en
  ru
  de
  es
  ar
}

enum UserAppearance {
  system
  light
  dark
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  telegramUserId BigInt         @unique
  username       String?
  firstName      String?
  lastName       String?
  languageCode   String?
  locale         UserLocale     @default(en)
  appearance     UserAppearance @default(system)
  isDeleted      Boolean        @default(false)
  deletedAt      DateTime?      @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  tournamentParticipants TournamentParticipant[]
  predictions            Prediction[]
  dailyPredictionUsage   DailyPredictionUsage[]
  adRewards              AdReward[]
  ratingProfile          RatingProfile?
  ratingHistory          RatingHistory[]
  userAchievements       UserAchievement[]
  prizeEntitlements      PrizeEntitlement[]
  prizeClaims            PrizeClaim[]
  prizeWalletRevisions   PrizeWalletRevision[]
  idempotencyRecords     IdempotencyRecord[]

  @@index([createdAt])
}

model Competition {
  id                    String   @id @default(uuid()) @db.Uuid
  providerCompetitionId String   @unique
  code                  String   @unique
  name                  String
  slug                  String   @unique
  country               String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)

  fixtures Fixture[]

  @@index([isActive])
}

model Team {
  id             String   @id @default(uuid()) @db.Uuid
  providerTeamId String   @unique
  name           String
  slug           String   @unique
  shortName      String?
  country        String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  homeFixtures Fixture[] @relation("HomeTeamFixtures")
  awayFixtures Fixture[] @relation("AwayTeamFixtures")
}

model Tournament {
  id               String           @id @default(uuid()) @db.Uuid
  number           Int              @unique
  status           TournamentStatus
  startsAt         DateTime         @db.Timestamptz(6)
  endsAt           DateTime         @db.Timestamptz(6)
  prizePoolNanoTon BigInt
  prizeCurrency    PrizeCurrency    @default(USDT)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)

  participants      TournamentParticipant[]
  predictions       Prediction[]
  ratingHistory     RatingHistory[]
  prizeEntitlements PrizeEntitlement[]
  prizeDistribution PrizeDistributionTier[]

  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@index([status, startsAt, endsAt])
}

model PrizeDistributionTier {
  id           String   @id @default(uuid()) @db.Uuid
  tournamentId String   @db.Uuid
  sortOrder    Int
  fromRank     Int
  toRank       Int
  amount       Decimal  @db.Decimal(20, 8)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tournamentId, sortOrder])
  @@index([tournamentId, sortOrder])
}

model TournamentParticipant {
  id                      String   @id @default(uuid()) @db.Uuid
  tournamentId            String   @db.Uuid
  userId                  String   @db.Uuid
  tournamentPoints        Int      @default(0)
  predictionsCount        Int      @default(0)
  correctPredictionsCount Int      @default(0)
  finalRank               Int?
  ratingPerformanceZ      Decimal? @db.Decimal(12, 8)
  ratingDelta             Int?
  createdAt               DateTime @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @db.Timestamptz(6)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tournamentId, userId])
  @@index([tournamentId, tournamentPoints(sort: Desc)])
  @@index([tournamentId, tournamentPoints(sort: Desc), id])
  @@index([userId, tournamentId])
}

model Fixture {
  id                String             @id @default(uuid()) @db.Uuid
  providerFixtureId String             @unique
  competitionId     String             @db.Uuid
  homeTeamId        String             @db.Uuid
  awayTeamId        String             @db.Uuid
  kickoffAt         DateTime           @db.Timestamptz(6)
  status            FixtureStatus      @default(DRAFT)
  providerStatus    String?
  homeScore         Int?
  awayScore         Int?
  finalOutcome      PredictionOutcome?
  scoringSnapshotId String?            @unique @db.Uuid
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  homeTeam    Team        @relation("HomeTeamFixtures", fields: [homeTeamId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  awayTeam    Team        @relation("AwayTeamFixtures", fields: [awayTeamId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  snapshots       OutcomeSnapshot[] @relation("FixtureSnapshots")
  scoringSnapshot OutcomeSnapshot?  @relation("FixtureScoringSnapshot", fields: [scoringSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  predictions Prediction[]

  @@index([kickoffAt])
  @@index([status, kickoffAt])
  @@index([competitionId, kickoffAt])
  @@index([status, competitionId, kickoffAt])
  @@index([kickoffAt, status, competitionId])
}

model OutcomeSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  fixtureId       String   @db.Uuid
  homeRawOdds     Decimal  @db.Decimal(12, 6)
  drawRawOdds     Decimal  @db.Decimal(12, 6)
  awayRawOdds     Decimal  @db.Decimal(12, 6)
  homeProbability Decimal  @db.Decimal(10, 8)
  drawProbability Decimal  @db.Decimal(10, 8)
  awayProbability Decimal  @db.Decimal(10, 8)
  homePoints      Int
  drawPoints      Int
  awayPoints      Int
  snapshotAt      DateTime @db.Timestamptz(6)
  scoringVersion  String
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  fixture          Fixture      @relation("FixtureSnapshots", fields: [fixtureId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  activeForFixture Fixture?     @relation("FixtureScoringSnapshot")
  predictions      Prediction[]

  @@index([fixtureId])
  @@index([fixtureId, snapshotAt(sort: Desc)])
}

model Prediction {
  id                      String                 @id @default(uuid()) @db.Uuid
  userId                  String                 @db.Uuid
  tournamentId            String                 @db.Uuid
  fixtureId               String                 @db.Uuid
  outcomeSnapshotId       String                 @db.Uuid
  selectedOutcome         PredictionOutcome
  slotType                PredictionSlotType
  probabilityAtPrediction Decimal                @db.Decimal(10, 8)
  potentialPoints         Int
  resultStatus            PredictionResultStatus @default(PENDING)
  earnedPoints            Int                    @default(0)
  createdAt               DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime               @updatedAt @db.Timestamptz(6)
  settledAt               DateTime?              @db.Timestamptz(6)

  user             User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tournament       Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fixture          Fixture         @relation(fields: [fixtureId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  outcomeSnapshot  OutcomeSnapshot @relation(fields: [outcomeSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  consumedAdReward AdReward?       @relation("ConsumedAdReward")

  @@unique([userId, fixtureId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, tournamentId])
  @@index([tournamentId, resultStatus])
  @@index([fixtureId, resultStatus])
  @@index([fixtureId])
  @@index([outcomeSnapshotId])
}

model DailyPredictionUsage {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  businessDate DateTime @db.Date
  freeUsed     Int      @default(0)
  rewardedUsed Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, businessDate])
  @@index([userId, businessDate])
  @@index([businessDate])
}

model AdReward {
  id                     String         @id @default(uuid()) @db.Uuid
  userId                 String         @db.Uuid
  provider               String
  providerRewardId       String?
  placement              String?
  attemptKey             String         @unique
  ymid                   String?        @unique
  zoneId                 String?
  requestVar             String?
  eventType              String?
  rewardEventType        String?
  subZoneId              String?
  estimatedPrice         Decimal?       @db.Decimal(20, 8)
  status                 AdRewardStatus @default(CREATED)
  createdAt              DateTime       @default(now()) @db.Timestamptz(6)
  verifiedAt             DateTime?      @db.Timestamptz(6)
  rejectedAt             DateTime?      @db.Timestamptz(6)
  consumedAt             DateTime?      @db.Timestamptz(6)
  expiresAt              DateTime?      @db.Timestamptz(6)
  consumedByPredictionId String?        @unique @db.Uuid
  metadata               Json?

  user                 User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  consumedByPrediction Prediction? @relation("ConsumedAdReward", fields: [consumedByPredictionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([provider, providerRewardId])
  @@index([userId, status, expiresAt])
  @@index([status, expiresAt])
  @@index([provider, placement, status, expiresAt])
}

model RatingProfile {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @unique @db.Uuid
  rating             Int          @default(1500)
  league             RatingLeague @default(UNRANKED)
  qualifiedCupsCount Int          @default(0)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([rating(sort: Desc)])
  @@index([league, rating(sort: Desc)])
}

model RatingHistory {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @db.Uuid
  tournamentId       String       @db.Uuid
  ratingBefore       Int
  ratingAfter        Int
  ratingDelta        Int
  performanceZ       Decimal      @db.Decimal(12, 8)
  actualPercentile   Decimal      @db.Decimal(10, 8)
  expectedPercentile Decimal      @db.Decimal(10, 8)
  leagueBefore       RatingLeague
  leagueAfter        RatingLeague
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, tournamentId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([tournamentId])
  @@index([tournamentId, performanceZ(sort: Desc)])
}

model Achievement {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  userAchievements UserAchievement[]

  @@index([isActive])
}

model UserAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  achievementId String   @db.Uuid
  unlockedAt    DateTime @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt(sort: Desc)])
  @@index([achievementId])
}

model PrizeEntitlement {
  id             String   @id @default(uuid()) @db.Uuid
  tournamentId   String   @db.Uuid
  userId         String   @db.Uuid
  finalPlacement Int
  amount         Decimal  @db.Decimal(20, 8)
  asset          String   @default("USDT") @db.VarChar(12)
  network        String   @default("TRC20") @db.VarChar(24)
  settledAt      DateTime @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  tournament Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  claim      PrizeClaim?

  @@unique([tournamentId, finalPlacement])
  @@unique([tournamentId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([tournamentId])
}

model PrizeClaim {
  id                    String           @id @default(uuid()) @db.Uuid
  entitlementId         String           @unique @db.Uuid
  userId                String           @db.Uuid
  walletAddress         String           @db.VarChar(64)
  status                PrizeClaimStatus @default(UNDER_REVIEW)
  transactionHash       String?          @db.VarChar(128)
  claimedAt             DateTime         @db.Timestamptz(6)
  paidAt                DateTime?        @db.Timestamptz(6)
  actionRequiredMessage String?          @db.Text
  rejectionReason       String?          @db.Text
  createdAt             DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(6)

  entitlement     PrizeEntitlement     @relation(fields: [entitlementId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  walletRevisions PrizeWalletRevision[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@index([walletAddress])
}

model PrizeWalletRevision {
  id                    String   @id @default(uuid()) @db.Uuid
  claimId               String   @db.Uuid
  userId                String   @db.Uuid
  previousWalletAddress String   @db.VarChar(64)
  nextWalletAddress     String   @db.VarChar(64)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)

  claim PrizeClaim @relation(fields: [claimId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([claimId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  operation      String
  key            String
  requestHash    String?
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime? @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, operation, key])
  @@index([expiresAt])
  @@index([userId, operation, createdAt(sort: Desc)])
}
