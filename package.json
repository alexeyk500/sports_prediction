{
  "name": "sports-prediction",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "npm run db:test:reset && node --env-file=.env scripts/run-with-test-database.mjs vitest run tests/integration",
    "test:concurrency": "npm run db:test:reset && node --env-file=.env scripts/run-with-test-database.mjs vitest run tests/concurrency",
    "test:api": "vitest run tests/api",
    "test:e2e": "playwright test",
    "prisma:validate": "prisma validate",
    "prisma:migrate:create": "prisma migrate dev --create-only --name init",
    "db:test:migrate": "node --env-file=.env scripts/run-with-test-database.mjs prisma migrate deploy",
    "db:test:reset": "node --env-file=.env scripts/reset-test-database.mjs && node --env-file=.env scripts/run-with-test-database.mjs prisma migrate deploy",
    "db:seed:dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/seed-dev.mjs",
    "telegram:dev-init-data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/generate-telegram-dev-init-data.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "prisma": "^7.10.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
